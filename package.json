{
  "name": "normie-tools",
  "version": "0.0.0",
  "private": true,
  "description": "NT: everyday tools for people with no tech background. Plan and checks scaffold.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "test": "node scripts/run-all.mjs",
    "check:banned-characters": "node scripts/check-banned-characters.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:required-tests": "node scripts/check-required-tests.mjs",
    "check:ship-gate": "node scripts/ship-gate.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:markdown": "markdownlint-cli2",
    "check:jargon": "node scripts/check-banned-jargon.mjs",
    "check:reading-level": "node scripts/check-reading-level.mjs",
    "check:no-clutter": "node scripts/check-no-clutter.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:tools": "node --test \"tools/*/tests/*.test.mjs\"",
    "test:unit": "node --test \"scripts/tests/*.test.mjs\"",
    "build": "npm run build --workspace @nt/site",
    "test:site": "npm test --workspace @nt/site",
    "build:skills": "python3 scripts/build_skills.py",
    "test:skills": "python3 -m unittest discover -s skills/receipt-to-spreadsheet/tests -p \"test_*.py\"",
    "nt": "python3 cli/nt.py",
    "test:e2e": "npm run build && npm run test:e2e --workspace @nt/site",
    "test:a11y": "npm run build && npm run test:e2e --workspace @nt/site -- accessibility reduced-motion stepper-intro autosave-resume",
    "test:upload-contract": "npm test --workspace @nt/site -- UploadField upload-messages detectFileType && npm run build && npm run test:e2e --workspace @nt/site -- upload-error-contract"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.24.0"
  },
  "workspaces": [
    "site"
  ]
}
